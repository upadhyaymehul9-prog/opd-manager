generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clinic {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  name       String
  status     String   @default("trial") // trial | active | suspended
  plan       String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  patients                 Patient[]
  patient_registry         PatientRegistry?
  mlc_registry             MlcRegistry?
  mlc_records               MlcRecord[]
  mlc_record_revisions     MlcRecordRevision[]
  doctors                  Doctor[]
  users                    User[]
  patient_visits           PatientVisit[]
  roi_releases             RoiRelease[]
  visit_emr_revisions      VisitEmrRevision[]
  daily_tokens             DailyToken[]
  medicines                Medicine[]
  stock_batches            StockBatch[]
  stock_write_offs         StockWriteOff[]
  stock_audits             StockAudit[]
  stock_audit_lines        StockAuditLine[]
  consultation_bill_counter ConsultationBillCounter?
  pharmacy_bill_counters   PharmacyBillCounter[]
  prescriptions            Prescription[]
  prescription_items       PrescriptionItem[]
  pharmacy_bills           PharmacyBill[]
  pharmacy_bill_items      PharmacyBillItem[]
  visit_procedures         VisitProcedure[]
  clinic_settings          ClinicSettings?
  appointments             Appointment[]
  consultation_templates   ConsultationTemplate[]
  audit_logs               AuditLog[]
  patient_consents         PatientConsent[]
  incident_reports         IncidentReport[]
  patient_feedback         PatientFeedback[]
  lab_test_catalog         LabTestCatalog[]
  visit_lab_tests          VisitLabTest[]
  staff_attendance         StaffAttendance[]

  @@map("clinics")
}

model Patient {
  id             String         @id @default(uuid()) @db.Uuid
  clinic_id      String         @db.Uuid
  patient_number Int
  name           String
  mobile         String?
  address        String?
  allergies      String?
  blood_group    String?
  abha_id        String?
  gender         String?
  emergency_contact String?
  date_of_birth  DateTime?      @db.Date
  occupation     String?
  national_id_type String?
  national_id    String?
  mobile_verify_code String?
  mobile_verified_at DateTime?  @db.Timestamptz(6)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  visits         PatientVisit[]
  appointments   Appointment[]
  consents       PatientConsent[]
  roi_releases   RoiRelease[]
  /// Set when this record has been identified as a duplicate and merged
  /// into another patient. The row (and its patient_number) is never
  /// deleted -- it becomes a permanent redirect/tombstone so old references
  /// (printed reports, old records) still resolve.
  merged_into_patient_id String?   @db.Uuid
  merged_into            Patient?  @relation("PatientMerge", fields: [merged_into_patient_id], references: [id], onDelete: SetNull)
  merged_from            Patient[] @relation("PatientMerge")
  merged_at              DateTime? @db.Timestamptz(6)
  merge_reason           String?
  merged_by              String?
  clinic                 Clinic    @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([mobile])
  @@index([name])
  @@index([abha_id])
  @@index([merged_into_patient_id])
  @@index([clinic_id])
  @@unique([clinic_id, patient_number])
  @@unique([clinic_id, abha_id])
  @@map("patients")
}

model PatientRegistry {
  clinic_id   String @id @db.Uuid
  clinic      Clinic @relation(fields: [clinic_id], references: [id], onDelete: Restrict)
  last_number Int    @default(0)

  @@map("patient_registry")
}

model MlcRegistry {
  clinic_id   String @id @db.Uuid
  clinic      Clinic @relation(fields: [clinic_id], references: [id], onDelete: Restrict)
  last_number Int    @default(0)

  @@map("mlc_registry")
}

/// A medico-legal case is its own structured, permanent record (not a
/// free-text blob on the visit) so it can carry the fields NABH/legal
/// review actually requires: a casualty register number, identification
/// marks, and — critically — proof that police were intimated, since that
/// is mandatory regardless of patient consent. Corrections never overwrite
/// (see MlcRecordRevision); the record itself is never deleted.
model MlcRecord {
  id                         String              @id @default(uuid()) @db.Uuid
  clinic_id                  String              @db.Uuid
  patient_visit_id           String              @unique @db.Uuid
  casualty_number             Int
  arrival_at                 DateTime            @db.Timestamptz(6)
  brought_by_name            String?
  brought_by_relation        String?
  history_own_words          String?
  identification_mark_1      String?
  identification_mark_2      String?
  injury_description         String?
  treatment_given            String?
  patient_status             String?
  dying_declaration_needed   Boolean             @default(false)
  evidence_collected         String?
  police_station             String?
  police_officer_name        String?
  fir_ddr_number              String?
  police_intimated_at        DateTime?           @db.Timestamptz(6)
  acknowledgment_receipt_ref String?
  acknowledgment_received_at DateTime?           @db.Timestamptz(6)
  created_by                 String
  created_by_role            String
  created_at                 DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime            @updatedAt @db.Timestamptz(6)
  patient_visit               PatientVisit        @relation(fields: [patient_visit_id], references: [id], onDelete: Restrict)
  revisions                  MlcRecordRevision[]
  clinic                     Clinic              @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([patient_visit_id])
  @@index([police_intimated_at])
  @@index([clinic_id])
  @@unique([clinic_id, casualty_number])
  @@map("mlc_records")
}

/// Snapshot of an MlcRecord's fields taken before any correction overwrites
/// them — same append-only pattern as VisitEmrRevision.
model MlcRecordRevision {
  id              String    @id @default(uuid()) @db.Uuid
  clinic_id       String    @db.Uuid
  mlc_record_id   String    @db.Uuid
  snapshot        String
  changed_by      String
  changed_by_role String
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  mlc_record      MlcRecord @relation(fields: [mlc_record_id], references: [id], onDelete: Restrict)
  clinic          Clinic    @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([mlc_record_id])
  @@index([clinic_id])
  @@map("mlc_record_revisions")
}

model Doctor {
  id             String         @id @default(uuid()) @db.Uuid
  clinic_id      String         @db.Uuid
  name           String
  room_number    String
  specialty      String?
  bio            String?
  qualifications String?
  photo_url      String?
  consultation_fee Float?
  opd_status     String         @default("offline")
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  patient_visits PatientVisit[]
  prescriptions  Prescription[]
  appointments   Appointment[]
  users          User[]
  consultation_templates ConsultationTemplate[]
  clinic         Clinic         @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([clinic_id])
  @@map("doctors")
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  clinic_id             String    @db.Uuid
  username              String
  password_hash         String
  role                  String
  display_name          String?
  doctor_id             String?   @db.Uuid
  doctor                Doctor?   @relation(fields: [doctor_id], references: [id], onDelete: SetNull)
  failed_login_attempts Int       @default(0)
  locked_until          DateTime? @db.Timestamptz(6)
  /// Forces a password change on next login. True for every seeded default
  /// account; cleared once the user sets their own password.
  must_change_password  Boolean   @default(true)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  clinic                Clinic    @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([clinic_id])
  @@unique([clinic_id, username])
  @@map("users")
}

model PatientVisit {
  id              String    @id @default(uuid()) @db.Uuid
  clinic_id       String    @db.Uuid
  patient_id      String?   @db.Uuid
  token_number    Int
  patient_name    String
  doctor_id       String    @db.Uuid
  room_number     String
  status          String    @default("registered")
  patient_type    String    @default("new")
  age             Int?
  gender          String?
  mobile          String?
  address         String?
  medico_legal    Boolean   @default(false)
  mlc_details     String?
  point_of_origin String    @default("walk_in")
  lab_referred    Boolean   @default(false)
  radio_referred  Boolean   @default(false)
  lab_eta         DateTime? @db.Timestamptz(6)
  radio_eta       DateTime? @db.Timestamptz(6)
  lab_started_at  DateTime? @db.Timestamptz(6)
  lab_ready_at    DateTime? @db.Timestamptz(6)
  radio_started_at DateTime? @db.Timestamptz(6)
  radio_ready_at  DateTime? @db.Timestamptz(6)
  registered_at   DateTime  @default(now()) @db.Timestamptz(6)
  completed_at    DateTime? @db.Timestamptz(6)
  consultation_fee        Float?
  consultation_payment_mode String?
  consultation_bill_no      String?
  consultation_paid_at      DateTime? @db.Timestamptz(6)
  chief_complaint           String?
  provisional_diagnosis     String?
  final_diagnosis           String?
  // ICD-10 coding of the final diagnosis (NABH IMS.1d). Description is a
  // snapshot taken when coded so records stay stable if the curated list changes.
  icd_code                  String?
  icd_description           String?
  diagnosis                 String?
  examination_notes         String?
  advice                    String?
  lifestyle_advice          String?
  investigations_ordered    String?
  follow_up_instructions    String?
  referral_notes            String?
  follow_up_date            DateTime? @db.Date
  signed_at                 DateTime? @db.Timestamptz(6)
  signed_by                 String?
  signed_by_role            String?
  vitals_bp                 String?
  vitals_pulse              Int?
  vitals_temp               Float?
  vitals_weight             Float?
  vitals_height_cm          Float?
  vitals_spo2               Int?
  /// Random Blood Sugar, mg/dL — captured as a vital (glucometer check at
  /// consultation), not a lab-sent test.
  vitals_rbs                Float?
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  patient         Patient?       @relation(fields: [patient_id], references: [id], onDelete: SetNull)
  doctors         Doctor         @relation(fields: [doctor_id], references: [id], onDelete: Restrict)
  prescription    Prescription?
  pharmacy_bill   PharmacyBill?
  procedures      VisitProcedure[]
  appointment     Appointment?
  consent         PatientConsent?
  roi_releases    RoiRelease[]
  incidents       IncidentReport[]
  emr_revisions   VisitEmrRevision[]
  mlc_record      MlcRecord?
  lab_tests       VisitLabTest[]
  clinic          Clinic         @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([doctor_id])
  @@index([patient_id])
  @@index([registered_at(sort: Desc)])
  @@index([patient_name])
  @@index([clinic_id])
  @@unique([clinic_id, consultation_bill_no])
  @@map("patient_visits")
}

/// Logs each release/disclosure of patient information for legal traceability.
model RoiRelease {
  id                    String        @id @default(uuid()) @db.Uuid
  clinic_id             String        @db.Uuid
  patient_visit_id      String?       @db.Uuid
  patient_id            String?       @db.Uuid
  patient_name          String
  patient_number        Int?
  requested_by          String
  requester_relation    String?
  purpose               String
  information_released  String
  release_mode          String        @default("printed_copy")
  identity_verified     Boolean       @default(false)
  id_proof_type         String?
  id_proof_ref          String?
  approved_by           String?
  released_by           String
  released_by_role      String
  released_at           DateTime      @db.Timestamptz(6)
  remarks               String?
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  visit                 PatientVisit? @relation(fields: [patient_visit_id], references: [id], onDelete: SetNull)
  patient               Patient?      @relation(fields: [patient_id], references: [id], onDelete: SetNull)
  clinic                Clinic        @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([created_at(sort: Desc)])
  @@index([patient_visit_id])
  @@index([patient_id])
  @@index([clinic_id])
  @@map("roi_releases")
}

/// Snapshot of a visit's clinical fields taken immediately before an EMR
/// edit overwrites them, so every prior version is retained permanently
/// (append-only correction history — nothing is ever lost, only superseded).
model VisitEmrRevision {
  id               String       @id @default(uuid()) @db.Uuid
  clinic_id        String       @db.Uuid
  patient_visit_id String       @db.Uuid
  snapshot         String
  changed_by       String
  changed_by_role  String
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  patient_visit    PatientVisit @relation(fields: [patient_visit_id], references: [id], onDelete: Restrict)
  clinic           Clinic       @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([patient_visit_id])
  @@index([created_at(sort: Desc)])
  @@index([clinic_id])
  @@map("visit_emr_revisions")
}

model DailyToken {
  clinic_id  String   @db.Uuid
  visit_date DateTime @db.Date
  last_token Int      @default(0)
  clinic     Clinic   @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@id([clinic_id, visit_date])
  @@map("daily_tokens")
}

model Medicine {
  id                 String             @id @default(uuid()) @db.Uuid
  clinic_id          String             @db.Uuid
  name               String
  brand              String?
  form               String?
  strength           String?
  gst_rate           Float              @default(12)
  hsn_code           String?
  is_active          Boolean            @default(true)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  prescription_items PrescriptionItem[]
  stock_batches      StockBatch[]
  write_offs         StockWriteOff[]
  audit_lines        StockAuditLine[]
  clinic             Clinic             @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([brand])
  @@index([clinic_id])
  @@map("medicines")
}

model StockBatch {
  id          String          @id @default(uuid()) @db.Uuid
  clinic_id   String          @db.Uuid
  medicine_id String          @db.Uuid
  batch_no    String
  expiry_date DateTime        @db.Date
  quantity    Int
  pack_size   Int             @default(1)
  mrp         Float?
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  medicine    Medicine        @relation(fields: [medicine_id], references: [id], onDelete: Cascade)
  write_offs  StockWriteOff[]
  clinic      Clinic          @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([medicine_id])
  @@index([expiry_date])
  @@index([clinic_id])
  @@map("stock_batches")
}

model StockWriteOff {
  id          String      @id @default(uuid()) @db.Uuid
  clinic_id   String      @db.Uuid
  medicine_id String      @db.Uuid
  batch_id    String?     @db.Uuid
  batch_no    String
  quantity    Int
  reason      String      @default("expired")
  notes       String?
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  medicine    Medicine    @relation(fields: [medicine_id], references: [id], onDelete: Cascade)
  batch       StockBatch? @relation(fields: [batch_id], references: [id], onDelete: SetNull)
  clinic      Clinic      @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([medicine_id])
  @@index([created_at(sort: Desc)])
  @@index([clinic_id])
  @@map("stock_write_offs")
}

model StockAudit {
  id          String           @id @default(uuid()) @db.Uuid
  clinic_id   String           @db.Uuid
  audit_date  DateTime         @db.Date
  department  String           @default("pharmacy")
  notes       String?
  created_by  String?
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  lines       StockAuditLine[]
  clinic      Clinic           @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([audit_date(sort: Desc)])
  @@index([department])
  @@index([clinic_id])
  @@map("stock_audits")
}

model StockAuditLine {
  id            String     @id @default(uuid()) @db.Uuid
  clinic_id     String     @db.Uuid
  audit_id      String     @db.Uuid
  medicine_id   String     @db.Uuid
  medicine_name String
  system_qty    Int
  physical_qty  Int
  difference    Int
  notes         String?
  audit         StockAudit @relation(fields: [audit_id], references: [id], onDelete: Cascade)
  medicine      Medicine   @relation(fields: [medicine_id], references: [id], onDelete: Restrict)
  clinic        Clinic     @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([audit_id])
  @@index([medicine_id])
  @@index([clinic_id])
  @@map("stock_audit_lines")
}

model ConsultationBillCounter {
  clinic_id String @id @db.Uuid
  clinic    Clinic @relation(fields: [clinic_id], references: [id], onDelete: Restrict)
  last_no   Int    @default(0)

  @@map("consultation_bill_counter")
}

/// Per-day pharmacy bill sequence. An atomic upsert-increment on this row
/// serializes concurrent billing so two bills can't collide on bill_no.
/// visit_date is the IST calendar day (see lib/date-range istDateOnly).
model PharmacyBillCounter {
  clinic_id String   @db.Uuid
  bill_date DateTime @db.Date
  last_no   Int      @default(0)
  clinic    Clinic   @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@id([clinic_id, bill_date])
  @@map("pharmacy_bill_counter")
}

model Prescription {
  id                  String             @id @default(uuid()) @db.Uuid
  clinic_id           String             @db.Uuid
  patient_visit_id    String             @unique @db.Uuid
  doctor_id           String             @db.Uuid
  notes               String?
  status              String             @default("draft")
  sent_to_pharmacy_at DateTime?          @db.Timestamptz(6)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @updatedAt @db.Timestamptz(6)
  patient_visit       PatientVisit       @relation(fields: [patient_visit_id], references: [id], onDelete: Cascade)
  doctor              Doctor             @relation(fields: [doctor_id], references: [id], onDelete: Restrict)
  items               PrescriptionItem[]
  pharmacy_bill       PharmacyBill?
  clinic              Clinic             @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([clinic_id])
  @@map("prescriptions")
}

model PrescriptionItem {
  id               String       @id @default(uuid()) @db.Uuid
  clinic_id        String       @db.Uuid
  prescription_id  String       @db.Uuid
  medicine_id      String?      @db.Uuid
  medicine_name    String
  dose             String?
  frequency        String?
  duration_days    Int?
  quantity         Int?
  instructions     String?
  dispensed        Boolean      @default(false)
  dispensed_at     DateTime?    @db.Timestamptz(6)
  skipped          Boolean      @default(false)
  skip_reason      String?
  substituted_note String?
  sort_order       Int          @default(0)
  voided_at        DateTime?    @db.Timestamptz(6)
  voided_by        String?
  void_reason      String?
  prescription     Prescription @relation(fields: [prescription_id], references: [id], onDelete: Cascade)
  medicine         Medicine?    @relation(fields: [medicine_id], references: [id], onDelete: SetNull)
  clinic           Clinic       @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([prescription_id])
  @@index([clinic_id])
  @@map("prescription_items")
}

model PharmacyBill {
  id               String             @id @default(uuid()) @db.Uuid
  clinic_id        String             @db.Uuid
  bill_no          String
  patient_visit_id String             @unique @db.Uuid
  prescription_id  String             @unique @db.Uuid
  payment_mode     String
  subtotal         Float
  gst_total        Float
  /// Flat deduction applied to (subtotal + gst_total) at bill time.
  discount_amount  Float              @default(0)
  discount_reason  String?
  grand_total      Float
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  /// Never hard-deleted: a wrong/disputed bill is voided (kept, excluded
  /// from revenue), not removed — matches this app's append-only policy.
  voided_at        DateTime?          @db.Timestamptz(6)
  voided_by        String?
  voided_by_role   String?
  void_reason      String?
  /// Restrict: financial records must not vanish if a visit is deleted.
  patient_visit    PatientVisit       @relation(fields: [patient_visit_id], references: [id], onDelete: Restrict)
  prescription     Prescription       @relation(fields: [prescription_id], references: [id], onDelete: Restrict)
  items            PharmacyBillItem[]
  clinic           Clinic             @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([created_at(sort: Desc)])
  @@index([clinic_id])
  @@unique([clinic_id, bill_no])
  @@map("pharmacy_bills")
}

model PharmacyBillItem {
  id                   String       @id @default(uuid()) @db.Uuid
  clinic_id            String       @db.Uuid
  bill_id              String       @db.Uuid
  prescription_item_id String?      @db.Uuid
  medicine_name        String
  hsn_code             String?
  quantity             Int
  unit_price           Float
  gst_rate             Float
  taxable_amount       Float
  gst_amount           Float
  line_total           Float
  bill                 PharmacyBill @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  clinic               Clinic       @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([bill_id])
  @@index([clinic_id])
  @@map("pharmacy_bill_items")
}

model VisitProcedure {
  id               String       @id @default(uuid()) @db.Uuid
  clinic_id        String       @db.Uuid
  patient_visit_id String       @db.Uuid
  procedure_type   String
  notes            String?
  fee              Float?
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  patient_visit    PatientVisit @relation(fields: [patient_visit_id], references: [id], onDelete: Cascade)
  clinic           Clinic       @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([patient_visit_id])
  @@index([procedure_type])
  @@index([created_at(sort: Desc)])
  @@index([clinic_id])
  @@map("visit_procedures")
}

/// One row per clinic. Operational settings, branding, and feature toggles
/// consumed by the (future) Clinic Settings admin page; today only the
/// operational fields (already existed) and defaults are read.
model ClinicSettings {
  clinic_id              String  @id @db.Uuid
  clinic                 Clinic  @relation(fields: [clinic_id], references: [id], onDelete: Cascade)

  slot_duration_minutes  Int     @default(15)
  opd_start_hour         Int     @default(9)
  opd_end_hour           Int     @default(18)
  gst_rate_percent       Decimal @default(12) @db.Decimal(5, 2)
  bill_number_prefix     String  @default("BILL")
  mlc_consent_text       String?

  display_name           String
  logo_url               String?
  primary_color          String  @default("#0f766e")

  radiology_enabled        Boolean @default(true)
  mlc_enabled               Boolean @default(true)
  pharmacy_billing_enabled Boolean @default(true)

  @@map("clinic_settings")
}

model Appointment {
  id               String        @id @default(uuid()) @db.Uuid
  clinic_id        String        @db.Uuid
  doctor_id        String        @db.Uuid
  patient_id       String?       @db.Uuid
  patient_name     String
  mobile           String?
  age              Int?
  scheduled_at     DateTime      @db.Timestamptz(6)
  duration_minutes Int           @default(15)
  status           String        @default("booked")
  source           String        @default("reception")
  external_ref     String?
  notes            String?
  visit_id         String?       @unique @db.Uuid
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  doctor           Doctor        @relation(fields: [doctor_id], references: [id], onDelete: Restrict)
  patient          Patient?      @relation(fields: [patient_id], references: [id], onDelete: SetNull)
  visit            PatientVisit? @relation(fields: [visit_id], references: [id], onDelete: SetNull)
  clinic           Clinic        @relation(fields: [clinic_id], references: [id], onDelete: Restrict)

  @@index([doctor_id, scheduled_at])
  @@index([scheduled_at(sort: Desc)])
  @@index([status])
  @@index([source])
  @@index([clinic_id])
  @@unique([clinic_id, external_ref])
  @@map("appointments")
}

model ConsultationTemplate {
